# mock = ใช้ข้อมูลจำลอง, redshift = ดึงจาก Amazon Redshift จริง
DATA_SOURCE=mock

# Login ของ Dashboard
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
SESSION_SECRET=change-this-to-a-long-random-string

# Amazon Redshift (private subnet, port 5439)
REDSHIFT_HOST=olytics-cluster.xxxxxx.us-east-1.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=dev
REDSHIFT_USER=awsuser
REDSHIFT_PASSWORD=
REDSHIFT_SCHEMA=public

# Amazon Athena (Query Lab) — Learner Lab credentials เปลี่ยนทุก session
AWS_REGION=us-east-1
ATHENA_DATABASE=olytics_curated
ATHENA_WORKGROUP=primary
ATHENA_OUTPUT_LOCATION=s3://your-bucket/athena-results/
