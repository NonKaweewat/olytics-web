[Unit]
Description=Olytics Next.js Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/olist-frontend/code web/olytics-web
ExecStart=/usr/bin/node-22 start-web.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1

[Install]
WantedBy=multi-user.target
